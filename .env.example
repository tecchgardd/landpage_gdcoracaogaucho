# Origem pública do backend (rewrites de /api e fallback do servidor)
NEXT_PUBLIC_API_URL=https://backend-coracaogaucho.vercel.app

# Opcional: endereço interno do backend/balanceador usado só pelo servidor do Next
# (cache do catálogo, generateMetadata e proxy de /api). Se vazio, usa NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# Segredo compartilhado com o backend para invalidar o cache do catálogo (POST /api/revalidate,
# header x-revalidate-secret). Gere com: openssl rand -hex 32
REVALIDATE_SECRET=

# Opcional: segredo enviado ao backend no header x-bff-key em toda chamada feita pelo servidor do Next.
# O backend pode recusar o que vier sem ele. Gere com: openssl rand -hex 32
BACKEND_SHARED_SECRET=
